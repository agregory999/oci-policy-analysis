      {
        "name": "policy_search_set",
        "description": "Run multiple related OCI policy queries in one call and compare their coverage. Prefer this tool over repeated policy_search calls when the question asks about two or more groups, services, human versus workload permissions, or a product/deployment permission checklist. Supply one searches item per check with search_id, label and filters (same fields as policy_search, including resource_family and structured principals). Use detail_level=\"summary\" for comparisons. Use intent=\"access_review\" for access comparisons, \"install_validation\" for a permission checklist, or \"workload_analysis\" for workload checks. product_or_service is a label, not a search filter. Returns search_results per check and set_summary with missing_required_searches and coverage caveats. Matches and likely_ready are statement evidence, not proof of effective access or installation readiness. Legacy items with query:{...} are still accepted. For a single lookup use policy_search.",
        "inputSchema": {
          "$defs": {
            "MCPPolicyFilters": {
              "additionalProperties": true,
              "description": "Discoverable common policy filters, with additional legacy fields retained.",
              "properties": {
                "action": {
                  "anyOf": [
                    {
                      "items": {
                        "enum": [
                          "allow",
                          "deny"
                        ],
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Statement actions. Use [\"allow\"] when asking which identities are granted access."
                },
                "principal": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/MCPPrincipalSelector"
                    },
                    {
                      "type": "null"
                    }
