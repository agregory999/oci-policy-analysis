{
  "jsonrpc": "2.0",
  "id": 1,
  "result": {
    "tools": [
      {
        "name": "policy_search",
        "description": "Search OCI IAM policies for one question. For two or more related checks, comparisons across groups/services, or a deployment permission checklist, prefer policy_search_set in one call. Principal filters: use filters.principal for one structured selector (for example {\"principal_type\":\"group\",\"domain_name\":\"Default\",\"name\":\"Admins\"} or {\"principal_type\":\"dynamic-group\"}), filters.principals for OR selectors, and filters.principal_keys for exact canonical keys such as group:default/admins (mixed-case inputs are accepted). Resource values are OCI policy types, not product names. For \"which groups can manage Object Storage\", use filters.action=[\"allow\"], filters.principal={\"principal_type\":\"group\"}, filters.verb=[\"manage\"], and filters.resource_family=\"object storage\". This expands to buckets, objects, objectstorage-namespaces, object-family, and all-resources. Results are matching statements, not a proof of effective access; conditions and scope still matter. The limit is a detailed-row threshold capped at 50, not pagination. Unfiltered or larger results return a summary with summary_substituted, summary_reason, and a hint to narrow the filters instead of statement rows.",
        "inputSchema": {
          "$defs": {
            "MCPPolicyFilters": {
              "additionalProperties": true,
              "description": "Discoverable common policy filters, with additional legacy fields retained.",
              "properties": {
                "action": {
                  "anyOf": [
                    {
                      "items": {
                        "enum": [
                          "allow",
                          "deny"
                        ],
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Statement actions. Use [\"allow\"] when asking which identities are granted access."
                },
                "principal": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/MCPPrincipalSelector"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "One structured identity selector, such as {\"principal_type\":\"group\"}."
                },
                "principals": {
                  "anyOf": [
                    {
                      "items": {
                        "$ref": "#/$defs/MCPPrincipalSelector"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Alternative identity selectors; any one may match."
                },
                "principal_keys": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Exact canonical principal keys."
                },
                "verb": {
                  "anyOf": [
                    {
                      "items": {
                        "enum": [
                          "inspect",
                          "read",
                          "use",
                          "manage"
                        ],
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "OCI IAM policy verbs. Values are exact matches; multiple values are alternatives."
                },
                "resource": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "OCI policy resource type identifiers, not service names. Values are alternatives. For Object Storage, use buckets, objects, objectstorage-namespaces, object-family, and all-resources; or use resource_family=\"object storage\" to include that full scope."
                },
                "resource_family": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Reference-data family name or alias. For example, \"object storage\" expands to buckets, objects, objectstorage-namespaces, object-family, and all-resources."
                },
                "permission": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "OCI permission names or substrings."
                },
                "policy_name": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Policy name substrings."
                },
                "effective_path": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Effective compartment paths."
                },
                "statement_text": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Raw policy statement text substrings."
                }
              },
              "type": "object"
            },
            "MCPPrincipalSelector": {
              "additionalProperties": true,
              "description": "One identity selector; populated fields are matched together.",
              "properties": {
                "principal_type": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Identity kind, such as group, dynamic-group, resource-principal, or instance-principal."
                },
                "domain_name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Identity domain, such as Default."
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Group, user, or dynamic-group name."
                },
                "ocid": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Exact identity OCID."
                },
                "principal_key": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Exact canonical principal key."
                },
                "resource_type": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Resource-principal OCI resource type."
                },
                "compartment_ocid": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Resource-principal compartment OCID."
                }
              },
              "type": "object"
            }
          },
          "properties": {
            "mode": {
              "default": "simple",
              "enum": [
                "simple",
                "advanced"
              ],
              "type": "string"
            },
            "detail_level": {
              "default": "simple",
              "enum": [
                "summary",
                "simple",
                "full"
              ],
              "type": "string"
            },
            "filters": {
              "anyOf": [
                {
                  "$ref": "#/$defs/MCPPolicyFilters"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "limit": {
              "default": 50,
              "description": "Detailed-row threshold, 1-50. Broader results become a summary; not pagination.",
              "type": "integer"
            }
          },
          "type": "object"
        },
        "outputSchema": {
          "additionalProperties": true,
          "type": "object"
        }
      },
