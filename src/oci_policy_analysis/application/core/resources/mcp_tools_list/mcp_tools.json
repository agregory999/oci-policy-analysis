                  "type": "boolean"
                },
                "require_service_principal_coverage": {
                  "default": false,
                  "description": "Check for service-principal evidence across results.",
                  "type": "boolean"
                },
                "require_tag_condition_coverage": {
                  "default": false,
                  "description": "Request tag coverage caveats; this is not evaluated authorization.",
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "MCPPolicySetSearch": {
