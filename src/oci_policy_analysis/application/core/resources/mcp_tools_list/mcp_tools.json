                },
                "limit": {
                  "default": 50,
                  "description": "Detailed-row threshold capped at 50, not pagination.",
                  "type": "integer"
                },
                "search_id": {
                  "default": "",
                  "description": "Unique identifier used in search_results and missing_required_searches.",
                  "type": "string"
                },
                "label": {
                  "default": "",
                  "description": "Short description of this comparison or required permission check.",
                  "type": "string"
                },
                "required": {
                  "default": true,
                  "description": "Include this check in required-match coverage; false makes it informational.",
                  "type": "boolean"
                },
                "query": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/MCPPolicySearchQuery"
