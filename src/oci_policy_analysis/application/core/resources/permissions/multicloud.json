        "ListMultiCloudMetadata": {"permissions": ["MULTICLOUDLINK_COMPARTMENTS_METADATA_INSPECT"], "notes": ""},
        "ListMulticloudResources": {
            "permissions": ["MULTICLOUD_RESOURCE_INSPECT", "COMPARTMENT_INSPECT"],
