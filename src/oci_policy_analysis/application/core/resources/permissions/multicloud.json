        "ListMulticloudSubscriptions": {
            "permissions": [
                "MULTICLOUD_SUBSCRIPTION_INSPECT",
                "ORGANIZATIONS_ASSIGNED_SUBSCRIPTION_READ",
                "SUBSCRIPTION_INFO_READ"
