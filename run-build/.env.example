# One file for run/build/deploy. Copy to run-build/.env.
# LOCAL ONLY: no edits required; use your existing ~/.oci/config + API key.
# CONTAINERS: fill the two REQUIRED blocks below. Everything else has a default.

# General Settings
# Web + MCP: 1=root, 2=root + direct children, 3=include grandchildren (max 6).
OPA_COMPARTMENT_DOMAIN_SEARCH_DEPTH=2
MCP_LOG_LEVEL=INFO
# Desktop uses saved preferences. Web uses its saved depth when this override is absent.

# Local Run and Build
# OPTIONAL: uncomment only to change a default. Choose the interface in the command:
# run/local.sh desktop|web|cli|mcp; run/build.sh installs all interfaces.
# LOCAL_OCI_PROFILE=DEFAULT
# LOCAL_HOST=127.0.0.1
# LOCAL_WEB_PORT=8000
# LOCAL_MCP_PORT=8765
# LOCAL_MCP_TRANSPORT=stdio
# PYTHON_BIN=python3.12

# Container Only
# REQUIRED for build/push AND deploy: operator identity, existing registry/repository.
OCI_PROFILE=DEFAULT
OCI_REGION=
OCI_COMPARTMENT_ID=
OCI_REGISTRY_HOST=
OCI_NAMESPACE=
OCI_REPOSITORY=
# REQUIRED for the selected interface; combined needs both, distinct release tags.
IMAGE_TAG_WEB=
IMAGE_TAG_MCP=

# REQUIRED for deploy ONLY: existing private network and target instance.
OCI_AVAILABILITY_DOMAIN=
OCI_SUBNET_ID=
OCI_NSG_ID=
OCI_INSTANCE_NAME=

# OPTIONAL: uncomment only to change a default or retain an existing backend IP.
# OCI_SHAPE=CI.Standard.E4.Flex
# OCI_OCPUS=1
# OCI_MEMORY_GB=8
# OCI_PRIVATE_IP=10.0.0.10
# WEB_PORT=8000
# MCP_PORT=8765
# BUILD_PLATFORM=linux/amd64
# Mode is chosen by command: run/deploy-container-instance.sh combined|web|mcp.
# Resource Principal, private VNIC, HTTP transport and bind addresses are automatic.
# Registry login: docker login YOUR_OCIR_HOST (credentials stay in Docker).
# Replacement/dry run are one-run command flags; see run/README.md.

# PIP Deployments
# OPTIONAL: only run/build-push-pypi.sh uses this; local-source builds ignore it.
# REQUIRED for that command: choose an exact published package version.
# OPA_VERSION=6.5.5

# MCP Oauth
# Leave false to skip this entire section. OPTIONAL: enable for OAuth-protected MCP.
MCP_OAUTH_ENABLED=false
# REQUIRED ONLY when enabled (values from your Identity Domain application):
# MCP_OAUTH_ISSUER=https://your-domain.identity.oraclecloud.com/
# MCP_OAUTH_JWKS_URI=https://your-domain.identity.oraclecloud.com/admin/v1/SigningCert/jwk
# MCP_OAUTH_AUDIENCE=your-resource-audience
# MCP_OAUTH_REQUIRED_SCOPES=read
# MCP_OAUTH_RESOURCE_SERVER_URL=https://your-mcp-host/mcp
# MCP_OAUTH_AUTHORIZATION_SERVER_URL=https://your-domain.identity.oraclecloud.com/
# Additional OAuth discovery/update options are documented in run/README.md.
