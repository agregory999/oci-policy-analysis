# .gitignore — OCI Policy Analysis

# --- Python cache & virtualenv ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.env/
.venv/
venv/
env/

# --- Build outputs ---
build/
dist/
wheelhouse/
*.spec
*.log

# --- OS & Editor files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.bak
*.tmp

# --- Ruff & MyPy caches ---
.ruff_cache/
.mypy_cache/

# --- Local artifacts ---
src/sample/
local_build.sh
local_build.ps1
old/

# --- GitHub & CI ---
# Keep workflow files
!.github/workflows/
# Ignore everything else under .github that isn't a workflow
.github/*
!.github/workflows/*
