# .gitignore — OCI Policy Analysis

# --- Python cache & virtualenv ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.env/
.venv/
venv/
env/

# --- Build outputs ---
build/
wheels/
dist/
wheelhouse/
*.spec
*.log
docs/build/
frozen.txt
uv.lock
package*.json

# Parser Jar
src/oci_policy_analysis/logic/parsers/antlr-4.13.2-complete.jar
*.interp
*.tokens

# --- OS & Editor files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.bak
*.tmp
*.bkp

# --- Ruff & MyPy caches ---
.ruff_cache/
.mypy_cache/

# --- Local artifacts ---
src/sample/
old/
private/

# --- GitHub & CI ---
# Keep workflow files
!.github/workflows/
# Ignore everything else under .github that isn't a workflow
.github/*
!.github/workflows/*

# --- Cline ---
.cline/
node_modules
