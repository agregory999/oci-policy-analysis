# .gitignore — OCI Policy Analysis

# --- Python cache & virtualenv ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.env/
.venv/
venv/
env/

# --- Build outputs ---
build/
wheels/
dist/
wheelhouse/
*.spec
*.log
docs/build/
docs/_build/
frozen.txt
deps.txt
deps2.txt
uv.lock
run/.env
run/.env.*
!run/.env.example
run/.container-private-ip
run/.container-instance-id
src/oci_policy_analysis/version.txt

# Parser Jar
src/oci_policy_analysis/application/core/resources/parsers/antlr-4.13.2-complete.jar
*.interp
*.tokens

# --- OS & Editor files ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.bak
*.tmp
*.bkp

# --- Test, coverage, Ruff & MyPy caches ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# --- Local artifacts ---
# src/sample/
old/
private/

# --- Cline ---
.cline/
node_modules/
# Local npm installs for release tooling; CI installs tools explicitly.
/package.json
/package-lock.json
usage-par.txt
iam-api-diagnostics*.csv
parsing-diagnostics*.csv

# --- Codex ---
.codex/
.gstack/

# Shared operator configuration and generated deployment state
run-build/.env
run-build/.env.*
!run-build/.env.example
run-build/*.json
env.sh
run/container.env

# Local OCI credentials and application cache/settings
.oci/
.oci-policy-analysis/

# Local resource-alias audit candidates
/resource-alias-candidates.md
