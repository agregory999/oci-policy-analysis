# Source builds need only package inputs and container launch scripts.
# Keep operator configuration, credentials, caches and deployment state out.
**
!pyproject.toml
!README.md
!src/
!src/**
!docker/
!docker/*-entrypoint.sh

# Non-package inputs and generated/local files within src/.
src/test/
src/sample/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.DS_Store
**/.env
**/.env.*
**/.oci/
**/.oci-policy-analysis/
**/*.log
